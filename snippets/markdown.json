{
    // ==========================================
    // MARKDOWN SNIPPETS
    // ==========================================

    // Hier ist Basis der Yaml-Frontmatter-Eintragungen.
    // Änderungen nur hier


    "Markdown Frontmatter": {
    "prefix": "frontmatter",
    "body": [
        "---",
        "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
        "source:",
        "origin:",
        "description:",
        "tags: $1",
        "---",
        "",
        "$0"
    ],
    "description": "Frontmatter Template. Angeglichen an Obsidian"
},


   // Bild 3 "bild" Nur für PELICAN! Bild einfügen (Pelican {static} Pfad) Muss zuvor aber noch mit
    // resize_images in c:\Tools\pelican\bildbearbeitung\ nach \images in verschieden
    // große Formate gebracht werden

    "Responsive Image": {
        "prefix": "bild",
        "body": [
            "<figure>",
            "  <img src=\"{static}/images/${1:bildname}-500px.jpg\"",
            "       srcset=\"/images/${1:bildname}-500px.jpg 1x,",
            "               /images/${1:bildname}-1000px.jpg 2x\"",
            "       alt=\"${2:Bildbeschreibung}\"",
            "       style=\"max-width: 100%; height: auto;\">",
            "  <figcaption>${3:Bildunterschrift}</figcaption>",
            "</figure>"
        ],
        "description": "Fügt responsives Bild mit Bildunterschrift ein"
    },


// Tabellen

    "Markdown Table 3 Columns": {
        "prefix": "tab3",
        "body": [
            "| ${1:Kopf 1} | ${2:Kopf 2} | ${3:Kopf 3} |",
            "|-----------|-----------|-----------|",
            "| ${4:Wert} | ${5:Wert} | ${6:Wert} |"
        ],
        "description": "Markdown Tabelle mit 3 Spalten"
    },

    "Markdown Table 2 Columns": {
        "prefix": "tab2",
        "body": [
            "| ${1:Kopf 1} | ${2:Kopf 2} |",
            "|-----------|-----------|",
            "| ${3:Wert} | ${4:Wert} |"
        ],
        "description": "Markdown Tabelle mit 2 Spalten"
    },

    // Youtube einfügen

    "YouTube Video Placeholder": {
        "prefix": "yt",
        "body": [
            "<!--",
            "1. Technische ID (ohne Leerzeichen): ${1:video-id}",
            "2. YouTube-ID (z.B. DInuHQGpe_0): ${2:DInuHQGpe_0}",
            "3. Titel für Leser: ${3:Mein Video}",
            "-->",
            "",
            "<div id=\"${1:video-id}\"",
            "     class=\"video-placeholder\"",
            "     style=\"background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),",
            "            url('https://img.youtube.com/vi/${2:DInuHQGpe_0}/hqdefault.jpg'); background-size: cover;\"",
            "     onclick=\"loadExternalContent('${1:video-id}', 'https://www.youtube.com/embed/${2:DInuHQGpe_0}')\">",
            "",
            "    <p><strong>${3:Mein Video}</strong><br>",
            "    Externer Inhalt von YouTube. Mit dem Laden akzeptieren Sie die Datenschutzbestimmungen von Google.</p>",
            "",
            "    <button class=\"play-button\">Video jetzt laden</button>",
            "</div>",
            "",
            "$0"
        ],
        "description": "YouTube-Placeholder mit Datenschutz-Hinweis"
    },


    "Mark Highlight": {
        "prefix": "mark",
        "body": [
            "<mark>${TM_SELECTED_TEXT:$1}</mark>"
        ],
        "description": "Text mit <mark> hervorheben"
    },

    "Markdown Link": {
        "prefix": "link",
        "body": [
            "[${1:Linktext}](${2:url})$0"
        ],
        "description": "Markdown-Link einfügen"
    },



    "Code Block": {
        "prefix": "code",
        "body": [
            "```${1:language}",
            "$2",
            "```",
            "$0"
        ],
        "description": "Code-Block mit Syntax-Highlighting"
    },
// Fußnote - funktioniert bei Export nach docx

    "Footnote": {
        "prefix": "fn",
        "body": [
            "[^${1:1}]",
            "",
            "[^${1:1}]: ${2:Fußnotentext}",
            "$0"
        ],
        "description": "Fußnote einfügen"
    }
}
