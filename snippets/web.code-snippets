{
    "Standalone HTML": {
        "scope": "html",
        "prefix": "html",
        "body": [
            "<!DOCTYPE html>",
            "<html lang=\"de\">",
            "<head>",
            "  <meta charset=\"utf-8\" />",
            "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
            "  <title>${1:Titel}</title>",
            "  <meta name=\"date\" content=\"$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE\" />",
            "",
            "  <style type=\"text/css\">",
            "/* CSS-SYNC-START (automatisch generiert von sync-css-snippet.js, nicht manuell editieren) */",
            "/* =========================================================",
            "   Grundlayout – Hellmodus (Standard)",
            "   ========================================================= */",
            "",
            "body {",
            "    font-family: \"Segoe UI\", 'Trebuchet MS', Tahoma, Arial, Helvetica, sans-serif;",
            "    font-size: 1.125rem;",
            "    line-height: 1.6;",
            "    max-width: 65ch;",
            "    margin: 0 auto;",
            "    padding: 1rem;",
            "    background-color: #ffffff;",
            "    color: #1a1a1a;",
            "}",
            "",
            "/* =========================================================",
            "   Typografie",
            "   ========================================================= */",
            "",
            "h1, h2, h3, h4, h5, h6 {",
            "    font-weight: bold;",
            "    line-height: 1.2;",
            "    margin-top: 1em;",
            "    margin-bottom: 0.5em;",
            "}",
            "",
            "h1 { font-size: 1.8rem; letter-spacing: 2px; color: rgb(113, 48, 4); }",
            "h2 { font-size: 1.4rem; color: #21ab21; }",
            "h3 { font-size: 1.2rem; font-style: italic; color: rgb(29, 83, 104); }",
            "h4 { font-size: 1.1rem; color: #7c9ede; }",
            "h5 { font-size: 1.1rem; margin-left: 1rem; font-style: italic; color: rgb(111, 116, 10); }",
            "h6 { font-size: 1.1rem; margin-left: 2rem; font-style: italic; color: grey; }",
            "",
            "/* =========================================================",
            "   Listen",
            "   ========================================================= */",
            "",
            "ul, ol {",
            "    line-height: 1.3;",
            "}",
            "",
            "ul li, ol li {",
            "    margin-bottom: 0.2em;",
            "}",
            "",
            "a {",
            "    color: #0645ad;      /* klassisches, gut lesbares Blau */",
            "    text-decoration: underline;",
            "}",
            "",
            "a:hover {",
            "    color: #0b66e0;",
            "}",
            "",
            "a:visited {",
            "    color: #5a3696;",
            "}",
            "",
            "/* =========================================================",
            "   Quelle",
            "   ========================================================= */",
            "",
            ".quelle {",
            "    font-size: 0.75em;",
            "    font-style: italic;",
            "    color: #555;",
            "}",
            "",
            "/* =========================================================",
            "   Blockquote",
            "   ========================================================= */",
            "",
            "blockquote {",
            "    padding-left: 1em;",
            "    border-left: 4px solid #bbb;",
            "    color: #2e2d2d;",
            "    font-style: italic;",
            "    margin: 1em 0;",
            "}",
            "",
            "/* =========================================================",
            "   Tabellen – Hellmodus",
            "   ========================================================= */",
            "",
            "table {",
            "    border-collapse: collapse;",
            "    margin: 1em 0;",
            "    width: 100%;",
            "    display: block;",
            "    overflow-x: auto;",
            "    background-color: #ffffff;",
            "}",
            "",
            "th, td {",
            "    border: 1px solid #666;",
            "    padding: 0.4em 0.7em;",
            "    text-align: left;",
            "    vertical-align: top;",
            "}",
            "",
            "th {",
            "    background-color: #eeeeee;",
            "    color: #1a1a1a;",
            "}",
            "",
            "tbody tr:nth-child(even) {",
            "    background-color: #f8f8f8;",
            "}",
            "",
            "/* =========================================================",
            "   Dark Mode – automatisch per System-Einstellung",
            "   ========================================================= */",
            "",
            "@media (prefers-color-scheme: dark) {",
            "",
            "    body {",
            "        background-color: #1a1a1a;",
            "        color: #f0f0f0;",
            "    }",
            "",
            "    /* Überschriften leicht aufgehellt */",
            "    h1 { color: rgb(255, 180, 120); }",
            "    h2 { color: #7be87b; }",
            "    h3 { color: rgb(150, 210, 230); }",
            "    h4 { color: #a9c7ff; }",
            "    h5 { color: rgb(200, 210, 80); }",
            "    h6 { color: #cccccc; }",
            "",
            "    .quelle {",
            "        color: #cccccc;",
            "    }",
            "",
            "    blockquote {",
            "        border-left-color: #666;",
            "        color: #e0e0e0;",
            "    }",
            "",
            "    @media (prefers-color-scheme: dark) {",
            "    a {",
            "        color: #82b4ff;      /* helles Blau, gut sichtbar auf dunklem Hintergrund */",
            "        text-decoration: underline;",
            "    }",
            "",
            "    a:hover {",
            "        color: #bcd6ff;",
            "    }",
            "",
            "    a:visited {",
            "        color: #c5a3ff;",
            "    }",
            "}",
            "",
            "",
            "    table {",
            "        background-color: #2a2a2a;",
            "    }",
            "",
            "    th, td {",
            "        border-color: #888;",
            "        color: #f0f0f0;",
            "    }",
            "",
            "    th {",
            "        background-color: #3a3a3a;",
            "    }",
            "",
            "    tbody tr:nth-child(even) {",
            "        background-color: #333333;",
            "    }",
            "}",
            "",
            "/* CSS-SYNC-END */",
            "  </style>",
            "",
            "</head>",
            "<body>",
            "  <main>",
            "  $0",
            "  </main>",
            "</body>",
            "</html>"
        ],
        "description": "Standalone HTML mit eingebettetem, automatisch synchronisiertem CSS"
    },
    "Responsive Image HTML": {
        "scope": "html",
        "prefix": "image",
        "body": [
            "<figure class=\"bild-container\">",
            "  <img",
            "    src=\"${1:bilddateinameUNDPfadeinfuegen.jpg}\"",
            "    alt=\"${2:Beschreibung}\"",
            "    style=\"width: 100%; height: auto;\"",
            "    class=\"bild-responsive\">",
            "  <figcaption>${3:Legende}</figcaption>",
            "</figure>"
        ],
        "description": "Responsive Figure für HTML"
    },
    "Responsive Image 460 HTML": {
        "scope": "html",
        "prefix": "imagesmall",
        "body": [
            "<figure class=\"bild-container\">",
            "  <img",
            "    src=\"${1:bilddateinameUNDPfadeinfuegen.jpg}\"",
            "    alt=\"${2:Beschreibung}\"",
            "    style=\"max-width: 460px; width: 100%; height: auto;\"",
            "    class=\"bild-responsive\">",
            "  <figcaption>${3:Legende}</figcaption>",
            "</figure>"
        ],
        "description": "Responsive Figure für HTML (max. 460px)"
    }
}